# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored and will never be committed.

# ---- Mail ----
ELS_SMTP_HOST=smtp.gmail.com
ELS_SMTP_PORT=587
ELS_SMTP_USER=hyunseo.kang238@gmail.com

# Gmail APP PASSWORD (16 chars), not your account password.
# Get one at https://myaccount.google.com/apppasswords
ELS_SMTP_PASSWORD=

ELS_MAIL_FROM=hyunseo.kang238@gmail.com
ELS_MAIL_TO=fan155@naver.com,leejy_93@naver.com

# ---- AI comment (optional) ----
# If empty, the comment is skipped and the report still sends normally.
ANTHROPIC_API_KEY=
ELS_AI_ENABLED=1
ELS_AI_MODEL=claude-sonnet-4-6
ELS_AI_WEB_SEARCH=1

# ---- Dashboard (optional) ----
# https://<your-id>.github.io/<repo-name>/
ELS_DASHBOARD_URL=
